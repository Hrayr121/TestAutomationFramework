<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!-- parallel="methods" + thread-count: drivers are isolated per thread (ThreadLocal in BaseTest). -->
<suite name="TestSuite1" verbose="1" parallel="methods" thread-count="1">

    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.testframework.core.listeners.AllureEnvironmentListener"/>
        <listener class-name="com.testframework.core.listeners.ScreenshotListener"/>
    </listeners>

    <test name="Examples">
        <packages>
            <package name="com.testframework.examples.tests"/>
        </packages>
    </test>

</suite>
